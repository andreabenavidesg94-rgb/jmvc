# =========================================================
# JMVC - Variables de entorno (ejemplo)
# Copia este archivo a .env y a .env.local con tus valores reales.
# Nunca subas .env ni .env.local al repositorio.
# =========================================================

# ----------- Aplicación -----------
NEXT_PUBLIC_APP_URL="https://jmvcapp.com"

# ----------- Base de datos -----------
# PostgreSQL connection string
DATABASE_URL="postgresql://neondb_owner:npg_MvwsXA24oTkB@ep-dark-rice-ab1241f8-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ----------- Auth (reservado para Auth.js / NextAuth - aún no usado) -----------
# Genera AUTH_SECRET con: openssl rand -base64 32
AUTH_SECRET="genera-una-clave-larga-aleatoria"
NEXTAUTH_URL="https://jmvcapp.com"

# =========================================================
# Paddle Billing
# =========================================================

# ----------- Paddle (cliente / frontend) -----------
# Token PÚBLICO usado por Paddle.js. Es seguro exponerlo en el navegador.
# Paddle Dashboard > Developer Tools > Authentication > Client-side tokens.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Entorno: "sandbox" o "production".
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# Price IDs públicos (los necesita el frontend para abrir el checkout).
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_MONTHLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PADDLE_PRICE_AGENCY_MONTHLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEARLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_YEARLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PADDLE_PRICE_AGENCY_YEARLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"

# ----------- Paddle (servidor / backend) -----------
# API key PRIVADA. NUNCA exponer en frontend.
# Paddle Dashboard > Developer Tools > Authentication > API Keys.
PADDLE_API_KEY="pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxx"

# Secret del webhook para verificar la firma `Paddle-Signature`.
# Paddle Dashboard > Developer Tools > Notifications > tu endpoint.
PADDLE_WEBHOOK_SECRET="pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxx"

# Price IDs en versión server (sin prefijo público). Pueden ser los mismos
# valores que los NEXT_PUBLIC_* o duplicados a propósito para separar
# rotación de claves entre frontend y backend.
# El webhook usa estos valores para mapear price ID -> plan/ciclo.
# Si no se configuran, el webhook cae a los NEXT_PUBLIC_* como fallback.
PADDLE_PRICE_STARTER_MONTHLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
PADDLE_PRICE_GROWTH_MONTHLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
PADDLE_PRICE_AGENCY_MONTHLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
PADDLE_PRICE_STARTER_YEARLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
PADDLE_PRICE_GROWTH_YEARLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"
PADDLE_PRICE_AGENCY_YEARLY="pri_xxxxxxxxxxxxxxxxxxxxxxx"

# =========================================================
# Datos legales (placeholders para footer y páginas legales)
# Reemplazar antes de publicar.
# =========================================================
NEXT_PUBLIC_COMPANY_LEGAL_NAME="[Nombre legal de la empresa]"
NEXT_PUBLIC_COMPANY_ADDRESS="[Dirección legal]"
NEXT_PUBLIC_COMPANY_TAX_ID="[Número fiscal si aplica]"
NEXT_PUBLIC_COMPANY_JURISDICTION="[País / jurisdicción]"
NEXT_PUBLIC_SUPPORT_EMAIL="[Correo de soporte]"
